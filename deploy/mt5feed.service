# Gold MT5 feed sidecar (Wine Python -> /opt/gold/mt5_last_candle.json)
#
# Same proven pattern as the mt5-balance / mt5-trades shell aliases:
# WINEPREFIX=~/.mt5 + xvfb-run + wine C:/Python312/python.exe.
#
# Install:
#   sudo cp deploy/mt5feed.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mt5feed
#
# The MT5 terminal must already be running and logged in in the SAME prefix
# (it currently is: `ps aux | grep terminal64.exe`).
#
# Adjust WINEPREFIX / python path / symbol if your layout differs
# (MT5_FEED_SYMBOL, MT5_FEED_FILE, MT5_FEED_POLL are env-overridable).

[Unit]
Description=Gold MT5 feed sidecar (Wine Python -> mt5_last_candle.json)
After=network.target

[Service]
User=root
Environment=WINEPREFIX=/root/.mt5
Environment=WINEDEBUG=-all
ExecStart=/usr/bin/xvfb-run --auto-servernum /usr/bin/wine C:\\Python312\\python.exe Z:\\opt\\gold\\tools\\mt5_feed.py
WorkingDirectory=/root
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
