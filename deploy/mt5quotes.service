# Gold XM quote + contract-spec logger (Wine Python -> /opt/gold/xm_data/)
#
# READ-ONLY sidecar (tools/mt5_quotes.py, docs/XM-LOGGER.md). Every 30 s it logs the XM GOLD
# bid/ask/spread (plus a 5 s min/max envelope) and the broker's server-time offset, and it
# snapshots the contract spec (execution/filling modes, stops level, contract size, swap,
# demo-vs-real), so the cost model ($0.20/side ASSUMED in strategy_lab) is MEASURED instead of
# guessed. It never sends, checks or lists orders and never touches engine.py or DATA_SOURCE.
# tools/autosync.sh commits xm_data/ with the other data.
#
# Same proven pattern as mt5feed and the mt5-balance / mt5-trades shell aliases:
# WINEPREFIX=~/.mt5 + xvfb-run + wine C:/Python312/python.exe.
#
# TEST FIRST (the terminal must be running and logged in, in the SAME prefix; it can run
# beside mt5feed - several Python clients may attach to one terminal):
#   export WINEPREFIX=/root/.mt5
#   xvfb-run --auto-servernum wine C:/Python312/python.exe Z:/opt/gold/tools/mt5_quotes.py --spec
#   xvfb-run --auto-servernum wine C:/Python312/python.exe Z:/opt/gold/tools/mt5_quotes.py --once
#
# Install (note the -gold suffix: the BTC bot's logger unit on a shared host has its own name):
#   sudo cp deploy/mt5quotes.service /etc/systemd/system/mt5quotes-gold.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mt5quotes-gold
#   journalctl -u mt5quotes-gold -f     # expect "contract spec recorded" and a quote row per 30 s
#
# Optional env (all have defaults): MT5_QUOTES_SYMBOL, MT5_QUOTES_DIR, MT5_QUOTES_INTERVAL,
# MT5_QUOTES_POLL, MT5_QUOTES_LABEL (free text published in the spec, e.g. "XM Standard demo" -
# MT5 does not expose the account tier). Never put a login or password here: the logger needs
# neither, and this repo is public.

[Unit]
Description=Gold XM quote + contract-spec logger (Wine Python -> xm_data/)
After=network.target

[Service]
User=root
Environment=WINEPREFIX=/root/.mt5
Environment=WINEDEBUG=-all
Environment=PYTHONUNBUFFERED=1
Environment=MT5_QUOTES_SYMBOL=GOLD
Environment=MT5_QUOTES_DIR=Z:/opt/gold/xm_data
#Environment=MT5_QUOTES_LABEL=XM Standard demo
ExecStart=/usr/bin/xvfb-run --auto-servernum /usr/bin/wine C:\\Python312\\python.exe Z:\\opt\\gold\\tools\\mt5_quotes.py
WorkingDirectory=/root
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
